# 服务
PORT=3000

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_edu
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=smart-edu-secret-change-me
JWT_EXPIRES=7d

# AI 大模型（OpenAI 兼容接口）
# 以下三家均为 OpenAI 兼容协议，国内可直连，任选其一即可。
# 未配置或留空时，AI 接口自动返回演示模式回复，不影响其他功能。
#
# --- 方案 A：火山引擎 豆包（推荐，有免费额度）---
#   1) 登录 https://www.volcengine.com/product/ark 开通方舟
#   2) 创建推理接入点（Endpoint）拿到模型 ID（形如 ep-xxxxxxxx）
#   3) 在「API Key」页生成 API Key
AI_API_BASE=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=your-volces-api-key
AI_MODEL=your-endpoint-id-or-model-id
#
# --- 方案 B：DeepSeek ---
# AI_API_BASE=https://api.deepseek.com/v1
# AI_API_KEY=your-deepseek-api-key
# AI_MODEL=deepseek-chat
#
# --- 方案 C：智谱 GLM ---
# AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=your-zhipu-api-key
# AI_MODEL=glm-4-flash
#
# --- 方案 D：硅基流动 SiliconFlow（聚合多模型，有免费额度）---
# AI_API_BASE=https://api.siliconflow.cn/v1
# AI_API_KEY=your-sf-api-key
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 文件上传
UPLOAD_DIR=uploads